{
  "ExpressoSample": {
    "Engine": "Sqlite"
  },
  "ConnectionStrings": {
    "SqlServer": "",
    "PostgreSql": "",
    "MySql": "",
    "MariaDb": "",
    "Sqlite": "",
    "Oracle": "",
    "Db2": ""
  },
  "Expresso": {
    "Policies": {
      "book": {
        "Rules": [
          "# Books: AND of 2..5 conditions, one level of OR, no NOT.",
          "filter := $cond | and($cond...[2,5])",
          "$cond := $pred | or($pred...[2,3])",
          "$pred := $string | $ordered | $count | any(authors, $author)",
          "$string := {eq,neq,startswith,endswith,contains}($title, ?)",
          "         | {eq,startswith,contains}(publisher | isbn, ?)",
          "         | in(title | isbn, ?...[1,20])",
          "$title := title | lower(title)",
          "$ordered := {eq,neq,gt,gte,lt,lte}(year | price | rating | createdat, ?)",
          "$count := {eq,gt,gte,lt,lte}(count(authors), ?)",
          "$author := {eq,startswith,contains}(displayname | firstname | lastname, ?)",
          "         | any(awards, {eq,contains}(title, ?))",
          "sort := title | year | price | rating | createdat | isbn | publisher",
          "      | sortfor(authors, lastname | firstname | displayname)",
          "      | sortfor(authors/awards, year | title)"
        ],
        "Limits": {
          "MaxDepth": 8,
          "MaxNodes": 100,
          "MaxSortKeys": 3
        },
        "ErrorDetail": "Generic"
      },
      "author": {
        "Rules": [
          "# Authors: open by default, with explicit forbidden operations.",
          "default allow",
          "deny or(*...) | not(*)",
          "deny {len,indexof,replace,substring,left,right}(..., ~firstname | ~lastname | ~displayname, ...)",
          "deny @datetime-add(~dateofbirth, ...)"
        ],
        "Limits": {
          "MaxDepth": 8,
          "MaxNodes": 100,
          "MaxSortKeys": 3
        },
        "ErrorDetail": "Generic"
      },
      "publisher": {
        "Rules": [
          "# Publishers: explicit equality on fields shared by all EF6 providers.",
          "# Time fields are omitted from this policy because Oracle and SQLite catalogs omit them.",
          "filter := $p | and($p...[2,5])",
          "$p := {eq,neq}(name | country | location, ?) | {startswith,endswith,contains}(name | country | location, ?)",
          "sort := name | country | location"
        ],
        "Limits": {
          "MaxDepth": 8,
          "MaxNodes": 100,
          "MaxSortKeys": 3
        },
        "ErrorDetail": "Generic"
      }
    }
  }
}
